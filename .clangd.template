# Optional clangd configuration for MSVC projects.
#
# ms2cc preserves the evaluated compiler command. Start without removals:
# current clangd versions strip output flags themselves and understand
# clang-cl-style PCH options.

Diagnostics:
  UnusedIncludes: None

CompileFlags:
  Add:
    - -ferror-limit=0

# If clangd reports that a specific MSVC-generated PCH is incompatible, scope a
# removal rule to affected files. Verify first that the PCH header is included
# directly or through /FI; /Yu<header> can imply inclusion.
#
# ---
# If:
#   PathMatch: path/to/affected/files/.*
# CompileFlags:
#   Remove:
#     - /Yc*
#     - /Yu*
#     - /Fp*
